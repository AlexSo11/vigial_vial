<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0A1628">

    <!-- Header fijo -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#131F35"
        android:padding="24dp"
        android:paddingTop="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nueva Incidencia"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Completa todos los campos del reporte"
            android:textSize="13sp"
            android:textColor="#8899AA"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Tipo de transporte -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tipo de Transporte"
                android:textSize="12sp"
                android:textColor="#8899AA"
                android:layout_marginBottom="6dp"/>

            <Spinner
                android:id="@+id/spinnerTransporte"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/input_bg_dark"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginBottom="20dp"/>

            <!-- Número de unidad -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Número de Unidad"
                android:textSize="12sp"
                android:textColor="#8899AA"
                android:layout_marginBottom="6dp"/>

            <EditText
                android:id="@+id/etNumeroUnidad"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Ej: 123, A-45"
                android:textColor="#FFFFFF"
                android:inputType="text"
                android:background="@drawable/input_bg_dark"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginBottom="20dp"/>

            <!-- Descripción -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Descripción de la incidencia"
                android:textSize="12sp"
                android:textColor="#8899AA"
                android:layout_marginBottom="6dp"/>

            <EditText
                android:id="@+id/etDescripcion"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:hint="Describe el problema con detalle..."
                android:textColor="#FFFFFF"
                android:inputType="textMultiLine"
                android:gravity="top|start"
                android:background="@drawable/input_bg_dark"
                android:padding="16dp"
                android:layout_marginBottom="20dp"/>

            <!-- Evidencia fotográfica -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Evidencia fotográfica (opcional)"
                android:textSize="12sp"
                android:textColor="#8899AA"
                android:layout_marginBottom="6dp"/>

            <Button
                android:id="@+id/btnSeleccionarFoto"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="📷  Seleccionar foto"
                android:backgroundTint="#1E2E45"
                android:textColor="#8899AA"
                android:layout_marginBottom="12dp"/>

            <ImageView
                android:id="@+id/ivPreview"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:scaleType="centerCrop"
                android:visibility="gone"
                android:layout_marginBottom="8dp"/>

        </LinearLayout>
    </ScrollView>

    <!-- Botón fijo abajo -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#131F35"
        android:padding="20dp">

        <Button
            android:id="@+id/btnReportar"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Reportar Incidencia"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#4F8EF7"/>
    </LinearLayout>

</LinearLayout>

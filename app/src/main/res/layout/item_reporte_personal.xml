<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="#131F35">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Fila superior: transporte + fecha -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <TextView
                android:id="@+id/tvTransporte"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="#4F8EF7"/>

            <TextView
                android:id="@+id/tvFecha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="#445566"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tvUnidad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#8899AA"
            android:textSize="13sp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvDescripcion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:ellipsize="end"
            android:textColor="#CCDDEE"
            android:textSize="14sp"
            android:layout_marginBottom="16dp"/>

        <!-- Barra de progreso 3 pasos -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <View
                    android:id="@+id/barPaso1"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:background="#4F8EF7"
                    android:layout_marginBottom="6dp"/>

                <TextView
                    android:id="@+id/tvPaso1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Recibido"
                    android:textSize="10sp"
                    android:textColor="#4F8EF7"
                    android:textStyle="bold"/>
            </LinearLayout>

            <View
                android:layout_width="8dp"
                android:layout_height="1dp"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <View
                    android:id="@+id/barPaso2"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:background="#1E2E45"
                    android:layout_marginBottom="6dp"/>

                <TextView
                    android:id="@+id/tvPaso2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="En Proceso"
                    android:textSize="10sp"
                    android:textColor="#445566"/>
            </LinearLayout>

            <View
                android:layout_width="8dp"
                android:layout_height="1dp"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <View
                    android:id="@+id/barPaso3"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:background="#1E2E45"
                    android:layout_marginBottom="6dp"/>

                <TextView
                    android:id="@+id/tvPaso3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Solucionado"
                    android:textSize="10sp"
                    android:textColor="#445566"/>
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
